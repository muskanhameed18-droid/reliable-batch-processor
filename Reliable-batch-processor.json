    {
      "parameters": {
        "jsCode": "function count(name) {\n  try { return $(name).all().length; } catch (e) { return 0; }\n}\n\nconst total = count('Validate Records');\nconst valid = count('Is Record Valid');\nconst invalid = total - valid;\nconst afterDedup = count('Remove Duplicates');\nconst duplicates = valid - afterDedup;\nconst sentToApi = count('Skip Already Processed');\nconst alreadyProcessed = afterDedup - sentToApi;\nconst apiSuccess = count('Log Success');\nconst apiErrors = count('Log API Error');\n\nreturn [{\n  json: {\n    total_records: total,\n    invalid_records: invalid,\n    duplicates_removed: duplicates,\n    already_processed: alreadyProcessed,\n    sent_to_api: sentToApi,\n    api_success: apiSuccess,\n    api_errors: apiErrors,\n    status: apiErrors > 0 ? 'Completed with errors' : 'Completed successfully'\n  }\n}];\n\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2768,
        1200
      ],
      "id": "5888d05d-53c5-44f2-bfb3-6fcfd9be96ba",
      "name": "Final Summary"
    },
    {
      "parameters": {
        "jsCode": "const done = new Set(\n  $('Get Processed IDs').all()\n    .filter(i => String(i.json.status).toLowerCase() === 'done')\n    .map(i => String(i.json.record_id))\n    .filter(x => x && x !== 'undefined')\n);\nconst records = $('Remove Duplicates').all();\nreturn records.filter(r => !done.has(String(r.json.record_id)));"
      },
